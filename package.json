{
  "name": "supercore-commerce-os",
  "version": "0.0.0",
  "private": true,
  "description": "Headless Vendure + Frappe bridge (ADR-010)",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "pnpm --filter @supercore/bridge dev",
    "build": "pnpm --filter @supercore/bridge build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "security:audit": "pnpm audit --prod"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.5.2",
    "eslint": "catalog:",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
