# Supercore Commerce OS — copy to .env for local development.
# Never commit real secrets.

NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgres://supercore:supercore@127.0.0.1:5433/supercore
REDIS_URL=redis://127.0.0.1:6380

API_PORT=4000
API_URL=http://127.0.0.1:4000
WEB_URL=http://127.0.0.1:3000
ADMIN_URL=http://127.0.0.1:3001
WEB_PORT=3000
ADMIN_PORT=3001

CORS_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:3001
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000

# Local-only. Must never be enabled in production.
AUTH_DEV_BYPASS=false

# Placeholders for later phases. Leave empty. Do not put real credentials here.
OPENAI_API_KEY=
HMRC_CLIENT_ID=
HMRC_CLIENT_SECRET=
PAYMENT_PROVIDER_API_KEY=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_ENDPOINT=
